# Telegram bot tokeni (@BotFather dan olinadi)
BOT_TOKEN=

# Admin Telegram ID'lari, vergul bilan ajratilgan
ADMIN_IDS=123456789,987654321

# PostgreSQL ulanish manzili
DATABASE_URL=postgres://user:password@localhost:5432/dbname

# Mavjud Django loyihangizning settings moduli
# (manage.py bilan bir papkadagi papka nomi + .settings)
DJANGO_SETTINGS_MODULE=myproject2.settings

# "Mening murojaatlarim" bo'limida nechta oxirgi ticket ko'rsatilsin
MY_TICKETS_LIMIT=5

# Log fayllar joylashadigan papka
LOG_DIR=logs
